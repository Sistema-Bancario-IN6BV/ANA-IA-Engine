# Plantilla del entorno Docker de desarrollo.
# Copia este archivo como '.env.docker' y completa los valores reales.
# '.env.docker' NUNCA se commitea (ver .gitignore) — este archivo sí.
# Leído por core/config.py (pydantic-settings) dentro del contenedor.

DEBUG=false

# LLM (Groq) — si falta, la app cae a respuestas por plantilla
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace
HUGGINGFACE_API_KEY=

# TTS — ElevenLabs (si falta, cae a edge-tts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# OCR
OCR_LANGUAGE=spa
