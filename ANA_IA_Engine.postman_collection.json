              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"No puedo dormir, estoy muy nervioso y no sé por qué\",\n  \"user_name\": \"Don Miguel\",\n  \"user_age\": 65\n}"
            },
            "url": {
              "raw": "{{base_url}}/chat",
              "host": ["{{base_url}}"],
              "path": ["chat"]
            }
