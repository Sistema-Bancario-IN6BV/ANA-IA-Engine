            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Me siento muy solo, mis hijos no me llaman hace semanas\",\n  \"user_name\": \"Doña Rosa\",\n  \"user_age\": 78\n}"
            },
            "url": {
              "raw": "{{base_url}}/chat",
              "host": ["{{base_url}}"],
              "path": ["chat"]
            }
          }
        },
        {
          "name": "Chat — Ansiedad",
          "request": {
            "method": "POST",
