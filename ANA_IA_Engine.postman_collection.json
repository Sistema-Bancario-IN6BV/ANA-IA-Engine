            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Ya no quiero seguir, todo es sin sentido y nadie me quiere\",\n  \"user_name\": \"Don Pedro\",\n  \"user_age\": 80\n}"
            },
            "url": {
              "raw": "{{base_url}}/chat",
