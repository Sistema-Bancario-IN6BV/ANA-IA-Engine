    },
    {
      "name": "Visión Computacional",
      "item": [
        {
          "name": "Vision — Detectar objetos (imagen)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Selecciona una imagen JPG o PNG"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/vision/detect",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "vision", "detect"]
            },
            "description": "Sube una imagen (JPG/PNG) para detectar objetos.\nDevuelve: lista de objetos, is_alone, medication_detected, fall_risk_detected, summary.\n\nNOTA: La primera llamada descarga el modelo DETR (~160MB) — puede tardar."
          }
        }
      ]
    },
    {
      "name": "Documentos / OCR",
      "item": [
        {
          "name": "Documents — Leer PDF o imagen",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Selecciona un PDF, PNG, JPG o TIFF"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/read",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "read"]
            },
            "description": "Extrae texto y entidades de salud de un documento.\nDevuelve: text, pages, entities (medicamentos, diagnósticos, fechas...), summary.\n\nREQUISITO: Tesseract OCR instalado en el sistema."
          }
        }
      ]
    }
  ]
